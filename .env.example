# ─────────────────────────────────────────────────────────────
# Copy these into Dokploy / Coolify → "Environment Variables".
# Never share the real values or commit them to GitHub.
# ─────────────────────────────────────────────────────────────

# Supabase → Project → Connect → "Session pooler" connection string (port 5432).
# Replace [YOUR-PASSWORD] with your database password. Do NOT add ?sslmode=...
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Max database connections per server (keep 10 unless Supabase complains)
DATABASE_POOL_MAX=10

# A long random password used to protect logins. Generate one at https://generate-secret.vercel.app/64
PAYLOAD_SECRET=change-me-to-a-long-random-string

# The public address of THIS dashboard (no trailing slash)
PAYLOAD_PUBLIC_SERVER_URL=https://cms.yourdomain.com

# The address(es) of your PWA, comma-separated. They are allowed to talk to this API.
FRONTEND_URLS=https://app.yourdomain.com

# Cloudflare R2 (photos & videos). Leave empty to store files on the server instead (not recommended).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket URL so the app loads images straight from Cloudflare (fast), e.g. https://media.yourdomain.com
R2_PUBLIC_URL=
